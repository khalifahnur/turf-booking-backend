# Copy to .env for local development. Never commit the real file.

PORT=8080
MONGO_URI=mongodb://localhost:27017

# REQUIRED. The server refuses to start without it: it is the key that verifies
# Paystack webhook signatures, and an empty key would let anyone forge a payment.
PAYSTACK_SK=

AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# Protects the admin endpoints, GET /api/v1/admin/bookings and
# GET /api/v1/admin/camp/registrations (customer and child names, phone numbers).
# At least 32 characters; generate with:  openssl rand -hex 32
# The SAME value goes in the Next.js app as ADMIN_API_KEY (server-side only,
# never NEXT_PUBLIC_). If unset, the admin endpoint is disabled.
ADMIN_API_KEY=

# Extra browser origins allowed to call the API and open the payment WebSocket,
# comma separated. The production site is always allowed. Example for local dev:
# ALLOWED_ORIGINS=http://localhost:3000
ALLOWED_ORIGINS=

# Public holidays to add to the built-in Kenyan calendar. Holidays are open from
# 07:00 to 01:00 like a weekend. The fixed ones (New Year, Labour Day, Madaraka,
# Mazingira, Mashujaa, Jamhuri, Christmas, Boxing Day, Good Friday, Easter Monday)
# are built in, with the Sunday-to-Monday rule. Eid-ul-Fitr and Eid-ul-Adha are
# announced by the Interior Cabinet Secretary a day or two before, so add each one
# here when it is gazetted, as comma-separated YYYY-MM-DD or YYYY-MM-DD=Name:
# EXTRA_HOLIDAYS=2027-03-09=Eid-ul-Fitr,2027-05-16=Eid-ul-Adha
# Restart the server after changing it; it logs the holidays it will use.
EXTRA_HOLIDAYS=

# How many reverse proxies sit in front of this server, so per-IP rate limits
# see real visitors rather than your load balancer.
#   auto (default) - trust X-Forwarded-For only when the TCP peer is a private
#                    address (platform load balancer / local nginx)
#   0              - no proxy, never trust X-Forwarded-For
#   1, 2, ...      - exactly this many trusted proxies (e.g. 2 for CDN + LB)
TRUSTED_PROXY_HOPS=auto
